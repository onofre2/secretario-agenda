{
  "expo": {
    "name": "Agenda Clínica",
    "slug": "secretario-agenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secretarioagenda.app"
    },
    "android": {
      "package": "com.secretarioagenda.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": ["NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "CAMERA"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para anexar documentos e exames ao paciente.",
          "cameraPermission": "O app usa a camera para fotografar documentos e exames do paciente."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O app salva fotos de documentos na sua galeria para nao perde-las.",
          "savePhotosPermission": "O app salva fotos de documentos na sua galeria para nao perde-las.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2c4a9eb7-dcb9-4fa5-81c0-13fc1d8ac5b3"
    },
    "owner": "ferreis-team",
    "extra": {
      "eas": {
        "projectId": "2c4a9eb7-dcb9-4fa5-81c0-13fc1d8ac5b3"
      }
    }
  }
}
